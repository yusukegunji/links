{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": [
      "./worker/worker-configuration.d.ts"
    ]
  },
  "include": [
    "worker",
    "shared"
  ],
  "exclude": [
    "worker/**/*.test.ts",
    "worker/test-utils.ts"
  ]
}
